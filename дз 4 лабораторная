## 2. Реализация программы
```c 
#include <stdio.h>
#include <locale.h>
int main() {
	setlocale(LC_CTYPE, "RUS");
	int A, B;
	int res;
	printf("===СИСТЕМА, ОТКРЫВАЮЩАЯ ДВЕРИ===\n");
	printf("Введите два целых числа (код 1 и код 2)\n");
	scanf("%d %d", &A, &B);
	res = ((A % 2 == 0 && B % 2 != 0) || (A % 2 != 0 && B % 2 == 0)); 
	printf("Доступ разрешен (1 - да, 0 - нет): %d\n", res);
	return 0;
}
```

